NEXT_PUBLIC_APP_TAGLINE="Excellence in Education, Character & Innovation"
NEXT_PUBLIC_SCHOOL_PHONE="+92 91 5828100"
NEXT_PUBLIC_SCHOOL_EMAIL="info@hayatabadmodel.edu.pk"

# Resend Email Notifications
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="The Hayatabad Model School <onboarding@resend.dev>"

# ================================================================
# SUPABASE CLOUD CONFIGURATION (Placeholders)
# ================================================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
SUPABASE_SECRET_KEY="your-secret-service-role-key"
